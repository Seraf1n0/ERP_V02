@page
@model ERP.Pages.Produccion.RegistrarMovimientoModel
@{
    Layout = "_LayoutProduccion";
}

<style>
    body {
        display: flex;
        justify-content: center;
        align-items: center;
        min-height: 100vh;
        background-color: #e0e0e0;
        font-family: Arial, sans-serif;
    }

    .container {
        display: flex;
        flex-direction: column;
        box-shadow: 8px 8px 0px rgba(0, 0, 0, 0.1);
        width: 80%;
        background-color: #ffffff;
        border-radius: 30px;
        padding: 25px;
        margin-top: 20px;
        transition: transform 0.2s ease;
    }

        .container:hover {
            transform: scale(1.02);
        }

    .table_header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 20px 30px 10px;
        border-bottom: 2px solid #13232f;
        margin-bottom: 1rem;
    }

        .table_header h2 {
            font-size: 1.5rem;
            font-weight: bold;
            color: #13232f;
        }

    .btn {
        outline: none;
        border: none;
        background-color: #13232f;
        color: #ffffff;
        padding: 12px 25px;
        border-radius: 20px;
        font-size: 14px;
        cursor: pointer;
        margin: 10px 0;
        transition: background-color 0.3s ease;
    }

        .btn:hover {
            background-color: #0a1c2b;
        }

    table {
        border-spacing: 0;
        margin-top: 1.5rem;
        width: 100%;
        box-shadow: 0px 4px 8px rgba(0, 0, 0, 0.1);
        border-radius: 10px;
        overflow: hidden;
    }

    thead {
        background-color: #13232f;
        color: white;
    }

    th, td {
        padding: 15px;
        text-align: center;
        border-bottom: 1px solid #dfdfdf;
        font-size: 14px;
    }

    th {
        font-weight: bold;
        text-transform: uppercase;
    }

    tr:nth-child(even) {
        background-color: #f9f9f9;
    }

    tr:hover {
        background-color: #f1f1f1;
    }

    .form-group {
        margin-bottom: 15px;
    }

        .form-group label {
            display: block;
            font-weight: bold;
            color: #333;
            margin-bottom: 5px;
        }

        .form-group select, .form-group input {
            width: 100%;
            padding: 10px;
            border: 1px solid #dfdfdf;
            border-radius: 10px;
            font-size: 14px;
            transition: border-color 0.3s ease;
            background-color: #ffffff;
            color: #333;
            box-shadow: 0px 4px 6px rgba(0, 0, 0, 0.1);
        }

            .form-group select:focus, .form-group input:focus {
                border-color: #13232f;
                outline: none;
            }

    .actions {
        display: flex;
        justify-content: flex-end;
        margin: 1rem 0;
    }

    /* Modal overlay */
    .modal-overlay {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        display: flex;
        justify-content: center;
        align-items: center;
        background-color: rgba(0, 0, 0, 0.5);
        z-index: 9999;
        opacity: 0;
        pointer-events: none;
        transition: opacity 0.3s ease;
    }

        .modal-overlay.active {
            opacity: 1;
            pointer-events: auto;
        }

    .modal-dialog {
        background-color: #ffffff;
        padding: 25px;
        border-radius: 12px;
        width: 90%;
        max-width: 600px;
        box-shadow: 0px 6px 12px rgba(0, 0, 0, 0.3);
        transition: transform 0.3s ease;
        transform: translateY(-20px);
    }

    .modal-overlay.active .modal-dialog {
        transform: translateY(0);
    }

    .modal-dialog h5 {
        font-size: 1.2rem;
        font-weight: bold;
        color: #13232f;
        margin-bottom: 20px;
    }

    .modal-actions {
        display: flex;
        justify-content: flex-end;
        margin-top: 20px;
    }

        .modal-actions .btn {
            padding: 10px 20px;
            border-radius: 20px;
            cursor: pointer;
        }

    .btn-secondary {
        background-color: #b0b0b0;
        color: #ffffff;
    }

        .btn-secondary:hover {
            background-color: #929292;
        }

    .btn-primary {
        background-color: #13232f;
        color: #ffffff;
    }

        .btn-primary:hover {
            background-color: #0a1c2b;
        }
</style>


<div class="container">
    <h1>Registrar Movimiento</h1>

    <form method="post">
        <div class="form-group">
            <label for="bodegaOrigen">Bodega de Origen:</label>
            <select id="bodegaOrigen" class="form-control" asp-for="BodegaOrigenSeleccionada">
                <option value="">Seleccione una bodega de origen</option>
                @foreach (var bodega in Model.bodegasDisponibles)
                {
                    <option value="@bodega.Codigo">@bodega.Nombre</option>
                }
            </select>
        </div>

        <div class="form-group">
            <label for="bodegaDestino">Bodega de Destino:</label>
            <select id="bodegaDestino" class="form-control" asp-for="BodegaDestinoSeleccionada">
                <option value="">Seleccione una bodega de destino</option>
                @foreach (var bodega in Model.bodegasDisponibles)
                {
                    <option value="@bodega.Codigo">@bodega.Nombre</option>
                }
            </select>
        </div>

        <!-- Select para el responsable -->
        <div class="form-group">
            <label for="responsable">Responsable del Movimiento:</label>
            <select id="responsable" class="form-control" asp-for="ResponsableSeleccionado">
                <option value="">Seleccione un responsable</option>
                @foreach (var empleado in Model.responsablesDisponibles)
                {
                    <option value="@empleado.Cedula">@empleado.NombreCompleto</option>
                }
            </select>
        </div>

        <button type="submit" asp-page-handler="MostrarModal" class="btn btn-primary">Cargar Artículos Disponibles</button>
    </form>

    <!-- Fecha y hora del movimiento -->
    <div class="form_group">
        <label for="fechaHora">Fecha y hora del movimiento:</label>
        <input type="datetime-local" id="fechaHora" name="fechaHora" class="form-control" value="@DateTime.Now.ToString("yyyy-MM-ddTHH:mm")" />
    </div>

    <form method="post" asp-page-handler="mostrarModal">
        <button type="submit" class="BotonAgregarProducto">Agregar producto</button>
    </form>

    <!-- Tabla para mostrar los productos movidos -->
    <div class="table_header">
        <h2>Productos en movimiento</h2>
    </div>

    <table>
        <thead>
            <tr>
                <th>Producto</th>
                <th>Cantidad</th>
                <th>Precio unitario</th>
                <th>Precio total</th>
            </tr>
        </thead>
        <tbody>
            <!-- Aquí se generarán dinámicamente las filas con los productos agregados -->
        </tbody>
    </table>

    <!-- Botón para registrar el movimiento -->
    <div class="actions">
        <button class="BotonRegistrar">Registrar movimiento</button>
    </div>
</div>

@if (Model.mostrarModal)
{
    <!-- Modal -->
    <div class="modal" tabindex="-1" style="display:block; background-color:rgba(0,0,0,0.5); position:fixed; top:0; left:0; width:100%; height:100%; display:flex; justify-content:center; align-items:center;">
        <div class="modal-dialog" style="background:white; padding:20px; border-radius:10px; width:80%; max-width:600px;">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Seleccionar Producto</h5>
                    <button type="button" class="close" aria-label="Close" onclick="cerrarModal()">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body">
                    <table class="table">
                        <thead>
                            <tr>
                                <th>Nombre</th>
                                <th>Familia</th>
                                <th>Precio Unitario</th>
                                <th>Marca</th>
                                <th>Cantidad</th>
                                <th>Agregar</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.articulosDisponibles != null && Model.articulosDisponibles.Count > 0)
                            {
                                @foreach (var articulo in Model.articulosDisponibles)
                                {
                                    <tr>
                                        <td>@articulo.nombre</td>
                                        <td>@articulo.familia</td>
                                        <td>@articulo.precio</td>
                                        <td>@articulo.marca</td>
                                        <td>
                                            <input type="number" id="cantidad_@articulo.codigo" value="1" min="1" class="form-control" style="width:70px;" />
                                        </td>
                                        <td>
                                            <button type="button" class="btn btn-primary" onclick="agregarProducto('@articulo.nombre', @articulo.precio, @articulo.codigo)">Agregar</button>
                                        </td>
                                    </tr>
                                }
                            } else
                            {
                                <p>No hay articulos disponibles para mostrar en este movimiento.</p>
                            }
                        </tbody>
                    </table>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" onclick="cerrarModal()">Cerrar</button>
                </div>
            </div>
        </div>
    </div>
}

<script>
    function agregarProducto(nombre, precio, codigo) {
        const cantidad = parseInt(document.getElementById('cantidad_' + codigo).value);
        if (isNaN(cantidad) || cantidad <= 0) {
            alert("Por favor, seleccione una cantidad válida.");
            return;
        }

        const precioTotal = cantidad * precio;

        const tabla = document.querySelector(".container table tbody");
        const fila = document.createElement("tr");
        fila.innerHTML = `
                <td>${nombre}</td>
                <td>${cantidad}</td>
                <td>${precio.toFixed(2)}</td>
                <td>${precioTotal.toFixed(2)}</td>
            `;

        tabla.appendChild(fila);
        cerrarModal();
    }

    function cerrarModal() {
        document.querySelector('.modal').style.display = 'none';
    }
</script>
